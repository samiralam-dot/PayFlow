# PayFlow V4 Environment Configuration Example

# Server Environment
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/payflow

# Security & Tokens
JWT_SECRET=payflow-production-jwt-master-secret-key-32charsmin
JWT_REFRESH_SECRET=payflow-production-refresh-jwt-secret-key-32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Distributed Coordination & Cache (Redis)
REDIS_URL=redis://localhost:6379

# Event Streaming (Kafka)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=payflow-engine
KAFKA_GROUP_ID=payflow-consumer-group

# Acquiring Provider Credentials (Test Sandbox)
RAZORPAY_KEY_ID=rzp_test_placeholder_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
WEBHOOK_SECRET=whsec_payflow_webhook_verification_secret

# Vite Frontend Variables
VITE_API_URL=http://localhost:4000
